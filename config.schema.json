{
  "pluginAlias": "Jablotron",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "This plugin works with Jablotron Alarms.\n\n1. Open the Home <img src='https://user-images.githubusercontent.com/3979615/78010622-4ea1d380-738e-11ea-8a17-e6a465eeec35.png' height='16.42px'> app on your device.\n2. Tap the Home tab, then tap <img src='https://user-images.githubusercontent.com/3979615/78010869-9aed1380-738e-11ea-9644-9f46b3633026.png' height='16.42px'>.\n3. Tap *Add Accessory*, and select *I Don't Have a Code or select More Options*.\n4. Select Accessory and Enter the Homebridge PIN, or scan the QR code in Homebridge UI.",
  "footerDisplay": "Control your Jablotron alarm system from your iOS device using HomeKit and Homebridge. Updated fork available [here](https://github.com/jdegouw/homebridge-jablotron-alarm).",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Jablotron",
        "required": true
      },
      "childBridge": {
        "title": "Run this plugin in a Child Bridge",
        "description": "Recommended for better stability. The plugin will run in a separate process.",
        "type": "boolean",
        "default": false
      },
      "services": {
        "title": "Services",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "title": "Id",
              "type": "integer",
              "default": 12345,
              "description": "ID of service obtained by configuration tool.",
              "required": true
            },
            "name": {
              "title": "Name",
              "type": "string",
              "default": "Home",
              "description": "Defines a name of a service.",
              "required": true
            },
            "username": {
              "title": "User name",
              "type": "string",
              "default": "username",
              "description": "Your Jablotron username. It is advised to create a new account for this purpose.",
              "required": true
            },
            "password": {
              "title": "Password",
              "type": "string",
              "default": "password",
              "description": "Jablotron password.",
              "required": true
            },
            "pincode": {
              "title": "Pin code",
              "type": "string",
              "default": "pin",
              "description": "PIN code for Jablotron unit.",
              "required": true
            },
            "autoRefresh": {
              "title": "Auto refresh",
              "type": "boolean",
              "default": true,
              "description": "Enables autorefresh mode that automatically polls the Jablotron status.",
              "required": true
            },
            "pollInterval": {
              "title": "Poll interval",
              "type": "integer",
              "default": 60,
              "description": "Interval (in seconds) to check the status of the alarm and accessories.",
              "required": true
            },
            "refreshOnStateChange": {
              "title": "Refresh on state change",
              "type": "boolean",
              "default": true,
              "description": "Automatically refresh after arming or disarming.",
              "required": true
            },
            "debug": {
              "title": "Debug",
              "type": "boolean",
              "default": false,
              "description": "Enable verbose logging. Only use when troubleshooting.",
              "required": false
            },
            "debugPayload": {
              "title": "Debug Payload",
              "type": "boolean",
              "default": false,
              "description": "Log full response payloads. Only use when troubleshooting.",
              "required": false
            },
            "sections": { ... },
            "switches": { ... },
            "outlets": { ... },
            "contact_sensors": { ... },
            "thermometers": { ... }
          }
        }
      }
    }
  },
  "layout": [
    {
      "key": "services",
      "type": "tabarray",
      "title": "{{ value.name || 'new service' }}",
      "items": [
        "services[].name",
        "services[].id",
        {
          "key": "services[]",
          "type": "section",
          "title": "Authorization",
          "expandable": true,
          "expanded": false,
          "items": [
            "services[].username",
            "services[].password",
            "services[].pincode"
          ]
        },
        {
          "key": "services[]",
          "type": "section",
          "title": "Advanced Settings",
          "expandable": true,
          "expanded": false,
          "items": [
            "services[].autoRefresh",
            "services[].pollInterval",
            "services[].refreshOnStateChange",
            "services[].debug",
            "services[].debugPayload"
          ]
        }
      ]
    },
    "childBridge"
  ]
}