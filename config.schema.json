{
  "pluginAlias": "Jablotron",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "This plugin connects your Jablotron JA-100 alarm system to Apple HomeKit via Homebridge.",
  "footerDisplay": "Control your Jablotron alarm from the Home app and Siri. Updated fork: [jdegouw/homebridge-jablotron-alarm](https://github.com/jdegouw/homebridge-jablotron-alarm)",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Plugin Name",
        "type": "string",
        "default": "Jablotron",
        "required": true
      },
      "childBridge": {
        "title": "Run in Child Bridge",
        "description": "Strongly recommended for stability. Runs the plugin in a separate process.",
        "type": "boolean",
        "default": false
      },
      "services": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "title": "Service ID",
              "type": "string",
              "description": "Service ID obtained from the configuration tool or debug log.",
              "required": true
            },
            "name": {
              "title": "Service Name",
              "type": "string",
              "default": "Home",
              "required": true
            },
            "username": {
              "title": "Username",
              "type": "string",
              "description": "Jablotron username (preferably a dedicated account).",
              "required": true
            },
            "password": {
              "title": "Password",
              "type": "string",
              "description": "Jablotron password.",
              "required": true
            },
            "pincode": {
              "title": "PIN Code",
              "type": "string",
              "description": "PIN code of your Jablotron alarm panel.",
              "required": true
            },
            "autoRefresh": {
              "title": "Auto Refresh",
              "type": "boolean",
              "default": true,
              "description": "Automatically poll the alarm status at regular intervals."
            },
            "pollInterval": {
              "title": "Poll Interval (seconds)",
              "type": "integer",
              "default": 60,
              "minimum": 10,
              "description": "How often to check the status (in seconds)."
            },
            "refreshOnStateChange": {
              "title": "Refresh on State Change",
              "type": "boolean",
              "default": true,
              "description": "Refresh all accessories after arming or disarming."
            },
            "debug": {
              "title": "Debug Logging",
              "type": "boolean",
              "default": false
            },
            "debugPayload": {
              "title": "Debug Payloads",
              "type": "boolean",
              "default": false,
              "description": "Log full API responses (only enable when troubleshooting)."
            },

            "sections": {
              "type": "array",
              "title": "Sections",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "title": "Name", "required": true },
                  "segment_id": { "type": "string", "title": "Segment ID", "required": true },
                  "armedMode": {
                    "type": "string",
                    "title": "Armed Mode",
                    "default": "Away",
                    "enum": ["Home", "Away", "Night"]
                  },
                  "partiallyArmedMode": {
                    "type": "string",
                    "title": "Partially Armed Mode",
                    "enum": ["Home", "Away", "Night", "Off"]
                  }
                }
              }
            },

            "switches": {
              "type": "array",
              "title": "Switches (PGM)",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "title": "Name", "required": true },
                  "segment_id": { "type": "string", "title": "Segment ID", "required": true }
                }
              }
            },

            "outlets": {
              "type": "array",
              "title": "Outlets (PGM)",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "title": "Name", "required": true },
                  "segment_id": { "type": "string", "title": "Segment ID", "required": true }
                }
              }
            },

            "contact_sensors": {
              "type": "array",
              "title": "Contact Sensors",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "title": "Name", "required": true },
                  "segment_id": { "type": "string", "title": "Segment ID", "required": true },
                  "reversed_status": {
                    "type": "boolean",
                    "title": "Reversed Status",
                    "default": false,
                    "description": "Reverse open/closed logic of the contact sensor."
                  }
                }
              }
            },

            "thermometers": {
              "type": "array",
              "title": "Thermometers",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "title": "Name", "required": true },
                  "segment_id": { "type": "string", "title": "Segment ID", "required": true },
                  "min_temperature": {
                    "type": "number",
                    "title": "Minimum Temperature",
                    "default": 0
                  },
                  "max_temperature": {
                    "type": "number",
                    "title": "Maximum Temperature",
                    "default": 100
                  }
                }
              }
            }
          }
        }
      }
    }
  },

  "layout": [
    {
      "key": "services",
      "type": "tabarray",
      "title": "{{ value.name || 'New Service' }}",
      "items": [
        "services[].name",
        "services[].id",
        {
          "key": "services[]",
          "type": "section",
          "title": "Authorization",
          "expandable": true,
          "expanded": false,
          "items": [
            "services[].username",
            "services[].password",
            "services[].pincode"
          ]
        },
        {
          "key": "services[]",
          "type": "section",
          "title": "Advanced Settings",
          "expandable": true,
          "expanded": false,
          "items": [
            "services[].autoRefresh",
            "services[].pollInterval",
            "services[].refreshOnStateChange",
            "services[].debug",
            "services[].debugPayload"
          ]
        },
        {
          "key": "services[]",
          "type": "section",
          "title": "Sections",
          "expandable": true,
          "expanded": false,
          "items": ["services[].sections"]
        },
        {
          "key": "services[]",
          "type": "section",
          "title": "Switches (PGM)",
          "expandable": true,
          "expanded": false,
          "items": ["services[].switches"]
        },
        {
          "key": "services[]",
          "type": "section",
          "title": "Outlets (PGM)",
          "expandable": true,
          "expanded": false,
          "items": ["services[].outlets"]
        },
        {
          "key": "services[]",
          "type": "section",
          "title": "Contact Sensors",
          "expandable": true,
          "expanded": false,
          "items": ["services[].contact_sensors"]
        },
        {
          "key": "services[]",
          "type": "section",
          "title": "Thermometers",
          "expandable": true,
          "expanded": false,
          "items": ["services[].thermometers"]
        }
      ]
    },
    "childBridge"
  ]
}
